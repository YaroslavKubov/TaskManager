<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TaskManager.Views.MainWindow"
        Title="Менеджер завдань"
        Width="650"
        Height="550"
        MinWidth="500"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">

	<Grid RowDefinitions="Auto,Auto,*,Auto" Margin="25">

		<StackPanel Grid.Row="0" Spacing="8">
			<TextBlock Text="Менеджер завдань"
                       FontSize="28"
                       FontWeight="Bold"/>

			<TextBlock Text="Додавайте, виконуйте та видаляйте свої завдання."
                       FontSize="14"
                       Foreground="Gray"/>
		</StackPanel>

		<Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              Margin="0,22,0,18">

			<StackPanel Grid.Column="0" Spacing="4">
				<TextBox x:Name="TaskInput"
                         Watermark="Введіть нове завдання..."
                         VerticalContentAlignment="Center"
                         MinHeight="40"/>

				<TextBlock x:Name="ErrorText"
                           Foreground="IndianRed"
                           FontSize="12"
                           IsVisible="False"/>
			</StackPanel>

			<Button Grid.Column="1"
                    Content="Додати"
                    MinWidth="100"
                    Margin="10,0,0,0"
                    Click="AddTask_Click"/>
		</Grid>

		<Border Grid.Row="2"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10">

			<ListBox x:Name="TasksList"
                     SelectionMode="Single">

				<ListBox.ItemTemplate>
					<DataTemplate>
						<StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    Margin="5">

							<CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>

							<TextBlock Text="{Binding Title}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
						</StackPanel>
					</DataTemplate>
				</ListBox.ItemTemplate>

			</ListBox>
		</Border>

		<Grid Grid.Row="3"
              ColumnDefinitions="*,Auto"
              Margin="0,15,0,0">

			<TextBlock x:Name="CounterText"
                       Text="Невиконаних завдань: 0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"/>

			<Button Grid.Column="1"
                    Content="Видалити вибране"
                    Click="DeleteTask_Click"/>
		</Grid>

	</Grid>
</Window>