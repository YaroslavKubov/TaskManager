<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TaskManager.Views.MainWindow"
        Title="Менеджер завдань"
        Width="750"
        Height="600"
        MinWidth="550"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">

	<Grid RowDefinitions="Auto,Auto,*,Auto" Margin="25">

		<StackPanel Grid.Row="0" Spacing="8">
			<TextBlock Text="Менеджер завдань"
                       FontSize="28"
                       FontWeight="Bold"/>

			<TextBlock Text="Додавайте, виконуйте та видаляйте свої завдання."
                       FontSize="14"
                       Foreground="Gray"/>
		</StackPanel>

		<Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              Margin="0,22,0,18">

			<StackPanel Grid.Column="0" Spacing="4">
				<TextBox x:Name="TaskInput"
                         Watermark="Введіть нове завдання..."
                         VerticalContentAlignment="Center"
                         MinHeight="40"/>

				<TextBlock x:Name="ErrorText"
                           Foreground="IndianRed"
                           FontSize="12"
                           IsVisible="False"/>
			</StackPanel>

			<Button Grid.Column="1"
                    Content="Додати"
                    MinWidth="100"
                    Margin="10,0,0,0"
                    Click="AddTask_Click"/>
		</Grid>

		<Border Grid.Row="2"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10">

			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<StackPanel x:Name="TasksPanel"
                            Spacing="8"/>
			</ScrollViewer>

		</Border>

		<TextBlock Grid.Row="3"
                   x:Name="CounterText"
                   Text="Невиконаних завдань: 0"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Margin="0,15,0,0"/>

	</Grid>
</Window>